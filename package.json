{
  "name": "daxton-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/check.mjs",
    "test": "node --test tools/*.test.mjs",
    "preview": "node server/preview.mjs",
    "format": "prettier --write \"templates/**/*.html\" \"dist/**/*.{html,css,js}\" \"tools/*.mjs\" \"server/*.mjs\" \"content/*.json\" \".vscode/*.json\" \"integrations/**/*.gs\"",
    "format:check": "prettier --check \"templates/**/*.html\" \"dist/**/*.{html,css,js}\" \"tools/*.mjs\" \"server/*.mjs\" \"content/*.json\" \".vscode/*.json\" \"integrations/**/*.gs\"",
    "images": "node tools/prepare-images.mjs"
  },
  "devDependencies": {
    "prettier": "3.7.4",
    "sharp": "0.35.5"
  }
}
